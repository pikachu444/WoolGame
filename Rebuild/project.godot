; New art-first 2.5D implementation. No legacy game code is loaded.
config_version=5

[application]
config/name="털실 구조대"
config/use_custom_user_dir=true
config/custom_user_dir_name="WoolRescue"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.77, 0.88, 0.935, 1)
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=592
window/size/viewport_height=1138
window/size/window_width_override=540
window/size/window_height_override=1038
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=2
environment/defaults/default_clear_color=Color(0.66, 0.81, 0.9, 1)

[gui]
theme/default_font="res://art/korean.res"

[input_devices]
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false
